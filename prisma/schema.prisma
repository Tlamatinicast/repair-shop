generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String
  address   String?
  notes     String?
  repairs   Repair[]
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repair {
  id                Int                @id @default(autoincrement())
  ticketNumber      String             @unique
  status            String             @default("RECEIVED")
  customer          Customer           @relation(fields: [customerId], references: [id])
  customerId        Int
  deviceType        String
  deviceBrand       String
  deviceModel       String
  serialNumber      String?
  issue             String
  diagnosis         String?
  notes             String?
  laborCost         Float              @default(0)
  totalCost         Float              @default(0)
  advancePayment    Float              @default(0)
  paymentStatus     String             @default("PENDING")
  password          String?
  isDefinedService  Boolean            @default(false)
  queueDate         DateTime?
  dueDate           DateTime?
  partsEta          DateTime?
  parts             RepairPart[]
  photos            RepairPhoto[]
  repairNotes       RepairNote[]
  statusLogs        RepairStatusLog[]
  sales             Sale[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deliveredAt         DateTime?
  contactPreference   String    @default("")
  accessories         String    @default("[]")
  physicalCondition   String    @default("[]")
  physicalNotes       String    @default("")
  serviceType         String    @default("DIAGNOSIS")
  authorizedDiagnosis Boolean   @default(false)
  clientSignature     String    @default("") @db.Text
  warrantyType        String    @default("NONE")
  warrantyVoided      Boolean   @default(false)
  warrantyVoidReason  String?
}

model RepairStatusLog {
  id        Int      @id @default(autoincrement())
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  repairId  Int
  status    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
}

model InventoryItem {
  id              Int          @id @default(autoincrement())
  name            String
  sku             String       @unique
  description     String?
  quantity        Int          @default(0)
  reservedQty     Int          @default(0)
  minQuantity     Int          @default(1)
  costPrice       Float        @default(0)
  salePrice       Float        @default(0)
  category        String
  location        String?
  repairParts     RepairPart[]
  saleItems       SaleItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model RepairPart {
  id        Int           @id @default(autoincrement())
  repair    Repair        @relation(fields: [repairId], references: [id], onDelete: Cascade)
  repairId  Int
  item      InventoryItem @relation(fields: [itemId], references: [id])
  itemId    Int
  quantity  Int           @default(1)
  unitPrice Float
  reserved  Boolean       @default(false)
}

model RepairPhoto {
  id        Int      @id @default(autoincrement())
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  repairId  Int
  url       String
  stage     String   @default("RECEIVED")
  caption   String?
  createdAt DateTime @default(now())
}

model RepairNote {
  id         Int      @id @default(autoincrement())
  repair     Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  repairId   Int
  content    String
  stage      String   @default("IN_REPAIR")
  photoUrl   String?  // legacy: single photo (kept for backward compatibility)
  photoUrls  String?  // JSON array of photo URLs, e.g. '["/uploads/notes/1/note-123.webp"]'
  authorName String
  authorRole String
  createdAt  DateTime @default(now())
}

model Sale {
  id            Int            @id @default(autoincrement())
  saleNumber    String         @unique
  customer      Customer?      @relation(fields: [customerId], references: [id])
  customerId    Int?
  repair        Repair?        @relation(fields: [repairId], references: [id])
  repairId      Int?
  items         SaleItem[]
  payments      SalePayment[]
  subtotal      Float          @default(0)
  discount      Float          @default(0)
  total         Float          @default(0)
  amountPaid    Float          @default(0)
  paymentStatus String         @default("PENDING")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SalePayment {
  id            Int      @id @default(autoincrement())
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId        Int
  amount        Float
  paymentMethod String   @default("CASH")
  notes         String?
  createdAt     DateTime @default(now())
}

model SaleItem {
  id        Int           @id @default(autoincrement())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    Int
  item      InventoryItem @relation(fields: [itemId], references: [id])
  itemId    Int
  name      String
  quantity  Int           @default(1)
  unitPrice Float
  subtotal  Float
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TECHNICIAN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}
