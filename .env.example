# ─────────────────────────────────────────────────────────────
# Variables de entorno de RepairOS — copia este archivo a .env
# y rellena los valores. NUNCA subas el .env real al repo.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Railway la provee)
DATABASE_URL="postgresql://usuario:password@host:puerto/basededatos"

# NextAuth — OBLIGATORIO en producción.
# Genera uno con:  openssl rand -base64 32
NEXTAUTH_SECRET="pon-aqui-una-cadena-larga-y-aleatoria"
NEXTAUTH_URL="https://tu-app.up.railway.app"   # en local: http://localhost:3000

# Cloudinary (fotos de evidencia)
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ─── Solo para el seed inicial (npm run db:seed) ───
# Si las dejas vacías, el seed genera contraseñas fuertes al azar
# y las imprime una sola vez en la consola.
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD=""
SEED_TECH_EMAIL="tecnico@tudominio.com"
SEED_TECH_PASSWORD=""
